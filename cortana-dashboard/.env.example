CORTANA_DASHBOARD_PASSWORD=replace-with-a-long-private-password
HERMES_WEBUI_BASE_URL=http://127.0.0.1:8787
NEXT_PUBLIC_HERMES_WEBUI_URL=/hermes/
# Optional only when the upstream WebUI itself requires authentication.
# Prefer leaving WebUI bound to loopback and protecting public access through Cosmic Cortana.
# HERMES_WEBUI_AUTH_HEADER=Bearer replace-me
# HERMES_WEBUI_COOKIE=hermes_auth=replace-me
# HERMES_WEBUI_DEFAULT_WORKSPACE=/absolute/path/to/workspace
NEXT_PUBLIC_TELEGRAM_BOT_URL=https://t.me/your_bot
NEXT_PUBLIC_N8N_URL=https://n8n.louislucid.com

# Optional local OS storage overrides.
# CORTANA_DATA_ROOT=/absolute/path/to/.cortana-os
# CORTANA_WORKSPACE_ROOT=/absolute/path/to/workspace
# CORTANA_MEMORY_VAULT_PATH=/absolute/path/to/obsidian-vault
